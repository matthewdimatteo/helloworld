pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- intro to game programming
-- lesson 08: variables
-- by matthew dimatteo

-- runs once at start
-- variables, objects
function _init()
	-- *** player variables
	plyr_n=1 -- sprite number
	plyr_x=4 -- x coordinate
	plyr_y=60 -- y coordinate
	
	-- *** key variables
	key_n=2 -- sprite number
	key_x=116 -- x coordinate
	key_y=60 -- y coordinate
end -- /function _init()

-- runs 30x/sec
-- movement, calculation
function _update()
	
end -- /function _update()

-- runs 30x/sec
-- output/graphics
function _draw()
	cls() -- refresh screen

	-- *** draw sprites
	-- "plug in" the player and key
	-- variables here
	spr(plyr_n,plyr_x,plyr_y)
	spr(key_n,key_x,key_y)
end -- /function _draw()
